rules_version = '2';

// TwoDo security rules
// - Each person owns their own user record and private (solo) data.
// - Pair codes can be looked up by any signed-in user so partners can link.
// - A couple's shared space is readable/writable only by the two people in it
//   (couple IDs are "couple_<uidA>_<uidB>").
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isCoupleMember(coupleId) {
      return signedIn() && coupleId.matches('couple_.*' + request.auth.uid + '.*');
    }

    // Individual user profiles
    match /users/{uid} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && request.auth.uid == uid;
      // You can edit your own profile. Your partner may only update the
      // link fields (status / couple / partner) when pairing or unpairing.
      allow update: if signedIn() && (
        request.auth.uid == uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'couple_id', 'partner_uid', 'partner_name'])
      );

      // Private solo data (votes, planner) — owner only
      match /{sub=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Partner invite codes
    match /pair_codes/{code} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.user_uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.user_uid == request.auth.uid;
    }

    // Shared couple space (profile, votes, planner, chat, custom events)
    match /couples/{coupleId} {
      allow read, write: if isCoupleMember(coupleId);
      match /{sub=**} {
        allow read, write: if isCoupleMember(coupleId);
      }
    }
  }
}
